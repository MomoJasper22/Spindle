# Supabase Configuration
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_publishable_key
SUPABASE_SECRET_KEY=sb_secret_your_secret_key
SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json

# Next.js Client-Compatible Public Mappings
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_publishable_key

# PayMongo Credentials
PAYMONGO_SECRET_KEY=sk_test_your_paymongo_secret_key
NEXT_PUBLIC_PAYMONGO_PUBLIC_KEY=pk_test_your_paymongo_public_key
